<launch>

  <node pkg="global_planner" exec="global_planner_node" name="global_planner_node" output="screen">
    <param from="$(find-pkg-share global_planner)/config/coarse_planner.yaml" />
    <!-- <param name="local_cluster_size" value="25" /> -->
    <!-- <param name="global_cluster_size" value="" /> -->
    <param name="max_range_of_local_frontiers" value="50.0" />
    <param name="min_clearance_cells" value="1.5" />
    <remap from="/visible_map" to="/projected_map" />
  </node>

  <node pkg="waypoint_bridge" exec="waypoint_bridge" name="waypoint_bridge" output="screen">
    <param from="$(find-pkg-share waypoint_bridge)/config/waypoint_bridge.yaml" />
    <param name="lookahead_distance" value="1.5" />
    <param name="reach_threshold" value="1.0" />
    <param name="preferred_clearance_cells" value="5.0" />
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
        args="-d $(find-pkg-share simulator)/rviz/expro.rviz" />

</launch>
