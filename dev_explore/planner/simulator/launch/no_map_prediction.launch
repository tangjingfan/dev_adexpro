<launch>

  <!-- /predicted_map is just the expanded visible map: nothing is predicted. -->
  <node pkg="map_prediction" exec="map_prediction_node" name="map_prediction_node" output="screen">
    <param from="$(find-pkg-share map_prediction)/config/map_prediction.yaml" />
    <param name="enable_prediction" value="false" />
    <remap from="/visible_map" to="/projected_map" />
  </node>

</launch>
