<launch>

  <node pkg="octomap_server" exec="octomap_server_node" name="octomap_server" output="screen">
    <param from="$(find-pkg-share simulator)/config/mapping_garage.yaml" />
    <remap from="cloud_in" to="/sensor_scan" />
  </node>

  <node pkg="grid_recorder" exec="grid_recorder" name="grid_recorder" output="screen" />

</launch>
