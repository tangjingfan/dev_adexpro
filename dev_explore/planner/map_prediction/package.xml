<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>map_prediction</name>
  <version>0.0.0</version>
  <description>Map prediction node with two interchangeable backends: a learned FPUnet predictor and an oracle that fills frontier local windows from a ground-truth occupancy grid.</description>
  <maintainer email="tangjingfan@gmail.com">Jingfan</maintainer>
  <license>TODO: License declaration</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <depend>prob_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
