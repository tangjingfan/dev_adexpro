<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prediction_eval</name>
  <version>0.0.0</version>
  <description>Scores /predicted_map against the ground-truth /gt_map cell by cell, records per-cell accuracy and publishes it as ProbGrids.</description>
  <maintainer email="tangjingfan@gmail.com">jingfan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>prob_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>simulator</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
