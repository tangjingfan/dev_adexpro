<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prediction_heatmap</name>
  <version>0.0.0</version>
  <description>Live matplotlib heatmaps of map-prediction accuracy, drawn from prediction_eval's results.</description>
  <maintainer email="tangjingfan@gmail.com">jingfan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>prob_msgs</depend>
  <exec_depend>prediction_eval</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
