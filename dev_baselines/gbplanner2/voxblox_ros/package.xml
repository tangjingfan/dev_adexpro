<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voxblox_ros</name>
  <version>1.0.0</version>
  <description>
    Voxblox ROS 2 interface. Provides TsdfServer and EsdfServer, which
    subscribe to pointclouds and TF transforms and maintain a TSDF/ESDF map.
    ROS 2 port of github.com/ethz-asl/voxblox.
  </description>

  <maintainer email="tangjingfan@gmail.com">tangjingfan</maintainer>
  <author email="helen.oleynikova@mavt.ethz.ch">Helen Oleynikova</author>
  <author email="marius.fehr@mavt.ethz.ch">Marius Fehr</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>pcl_conversions</depend>

  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libgoogle-glog-dev</depend>
  <depend>libgflags-dev</depend>

  <depend>minkindr</depend>
  <depend>minkindr_conversions</depend>
  <depend>voxblox</depend>
  <depend>voxblox_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
