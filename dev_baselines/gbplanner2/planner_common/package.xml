<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>planner_common</name>
  <version>1.0.0</version>
  <description>
    Common primitives shared by gbplanner2: graph, sampler, trajectory,
    parameter loading, and the MapManager abstraction with a voxblox-backed
    implementation. ROS 2 port (slimmed) of ntnu-arl/gbplanner_ros.
  </description>

  <maintainer email="tangjingfan@gmail.com">tangjingfan</maintainer>
  <author>Mihir Dharmadhikari</author>
  <author>Tung Dang</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>

  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libgoogle-glog-dev</depend>

  <depend>kdtree</depend>
  <depend>planner_msgs</depend>
  <depend>minkindr</depend>
  <depend>minkindr_conversions</depend>
  <depend>voxblox</depend>
  <depend>voxblox_msgs</depend>
  <depend>voxblox_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
