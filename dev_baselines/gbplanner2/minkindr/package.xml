<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>minkindr</name>
  <version>1.0.0</version>
  <description>
    Minimal kindr transformation primitives. Header-only library, ported to
    ROS 2 (ament_cmake). Source: github.com/ethz-asl/minkindr.
  </description>

  <maintainer email="tangjingfan@gmail.com">tangjingfan</maintainer>
  <author email="paul.furgale@gmail.com">Paul Furgale</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>libgoogle-glog-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
