<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voxblox</name>
  <version>1.0.0</version>
  <description>
    Voxblox: volumetric TSDF/ESDF mapping library, ROS-agnostic core.
    ROS 2 port of github.com/ethz-asl/voxblox.
  </description>

  <maintainer email="tangjingfan@gmail.com">tangjingfan</maintainer>
  <author email="helen.oleynikova@mavt.ethz.ch">Helen Oleynikova</author>
  <author email="marius.fehr@mavt.ethz.ch">Marius Fehr</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>libgoogle-glog-dev</depend>
  <depend>libgflags-dev</depend>
  <depend>libprotobuf-dev</depend>
  <depend>protobuf-compiler</depend>
  <depend>minkindr</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
